generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  recepcion
  tecnico
  cliente
}

enum OrderStatus {
  INGRESADA
  DIAGNOSTICO
  PRESUPUESTADA
  APROBADA
  EN_REPARACION
  CONTROL_CALIDAD
  LISTA_ENTREGA
  ENTREGADA
  CANCELADA
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  rol          Role
  nombre       String
  creadoEn     DateTime @default(now())
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  cedulaRif String   @unique
  telefono  String
  email     String?
  direccion String?
  creadoEn  DateTime @default(now())
  equipos   Equipo[]
}

model Equipo {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  tipo        String
  marca       String
  modelo      String
  serieImei   String?
  claveAcceso String?
  accesorios  String?
  creadoEn    DateTime @default(now())
  ordenes     Orden[]
}

model Repuesto {
  id          String  @id @default(cuid())
  sku         String  @unique
  nombre      String
  compatible  String?
  stock       Int     @default(0)
  stockMinimo Int     @default(0)
  costoUSD    Decimal @db.Decimal(12, 2)
  precioUSD   Decimal @db.Decimal(12, 2)
  ubicacion   String?
  movimientos Movimiento[]
}

enum TipoMovimiento {
  ENTRADA
  SALIDA_ORDEN
  AJUSTE
}

model Movimiento {
  id           String         @id @default(cuid())
  repuestoId   String
  repuesto     Repuesto       @relation(fields: [repuestoId], references: [id], onDelete: Cascade)
  tipo         TipoMovimiento
  cantidad     Int
  refOrden     String?
  motivo       String?
  usuario      String
  stockAntes   Int
  stockDespues Int
  creadoEn     DateTime       @default(now())

  @@index([repuestoId])
}

model Orden {
  id             String      @id @default(cuid())
  codigo         String      @unique
  clienteId      String
  equipoId       String
  estado         OrderStatus @default(INGRESADA)
  fallaDeclarada String
  diagnostico    String?
  tecnicoId      String?
  prioridad      String      @default("NORMAL")
  fechaPromesa   DateTime?
  fechaEntrega   DateTime?
  garantiaDias   Int         @default(30)
  creadoEn       DateTime    @default(now())
  equipo         Equipo      @relation(fields: [equipoId], references: [id])
  historial      EstadoHistorial[]
  presupuesto    Presupuesto?
  fotos          Foto[]
}

model Foto {
  id        String   @id @default(cuid())
  ordenId   String
  orden     Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  url       String
  tipo      String   @default("equipo")
  nota      String?
  creadoEn  DateTime @default(now())

  @@index([ordenId])
}

model EstadoHistorial {
  id        String      @id @default(cuid())
  ordenId   String
  orden     Orden       @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  de        OrderStatus
  a         OrderStatus
  usuario   String
  fecha     DateTime    @default(now())

  @@index([ordenId])
}

model Presupuesto {
  id           String   @id @default(cuid())
  ordenId      String   @unique
  orden        Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  manoObraUSD  Decimal  @db.Decimal(12, 2)
  tasaRef      Decimal  @db.Decimal(18, 2)
  totalUSDRef  Decimal  @db.Decimal(14, 2)
  totalVES     Decimal  @db.Decimal(14, 2)
  validezDias  Int      @default(7)
  aprobada     Boolean  @default(false)
  aprobadaPor  String?
  aprobadaEn   DateTime?
  creadoEn     DateTime @default(now())
  items        PresupuestoItem[]
}

model PresupuestoItem {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  sku           String
  cantidad      Int
  precioUSD     Decimal     @db.Decimal(12, 2)

  @@index([presupuestoId])
}

model TasaCambio {
  id             String   @id @default(cuid())
  fecha          DateTime @db.Date
  valorVESporUSD Decimal  @db.Decimal(18, 2)
  fuente         String   @default("MANUAL")
  usuarioId      String
  creadoEn       DateTime @default(now())

  @@unique([fecha])
}

model Cobro {
  id          String       @id @default(cuid())
  ordenId     String
  usuario     String       @default("sistema")
  tasaCobro   Decimal      @db.Decimal(18, 2)
  totalVES    Decimal      @db.Decimal(14, 2)
  totalUSDRef Decimal      @db.Decimal(14, 2)
  vueltoVES   Decimal      @db.Decimal(14, 2) @default(0)
  creadoEn    DateTime     @default(now())
  lineas      CobroLinea[]

  @@index([ordenId])
}

model CobroLinea {
  id      String @id @default(cuid())
  cobroId String
  cobro   Cobro  @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  metodo  String
  moneda  String
  monto   Decimal @db.Decimal(14, 2)

  @@index([cobroId])
}

model MovimientoCaja {
  id       String   @id @default(cuid())
  fecha    DateTime @db.Date
  usuario  String
  moneda   String
  monto    Decimal  @db.Decimal(14, 2)
  concepto String
  cobroId  String?
  creadoEn DateTime @default(now())

  @@index([fecha, usuario])
}

model CajaDiaria {
  id          String    @id @default(cuid())
  fecha       DateTime  @db.Date
  usuarioId   String
  tasaCierre  Decimal?  @db.Decimal(18, 2)
  inicialVES  Decimal   @db.Decimal(14, 2)
  inicialUSD  Decimal   @db.Decimal(14, 2)
  esperadoVES Decimal   @db.Decimal(14, 2)
  esperadoUSD Decimal   @db.Decimal(14, 2)
  contadoVES  Decimal?  @db.Decimal(14, 2)
  contadoUSD  Decimal?  @db.Decimal(14, 2)
  cerradaEn   DateTime?
}
