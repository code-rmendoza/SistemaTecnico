# ── Variables de entorno requeridas ──

# URL de conexión a PostgreSQL (pooler para la app, direct para migraciones)
# Producción: usar Neon pooler (port 5432) para la app, direct (port 5432) para prisma migrate
DATABASE_URL="postgresql://user:password@localhost:5432/sistema_tecnico"

# Secreto JWT (mínimo 32 caracteres, cambiar en producción)
JWT_SECRET="cambia-esto-en-produccion-min-32-chars"

# Zona horaria
TZ="America/Caracas"
